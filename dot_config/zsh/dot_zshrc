# Interactive shells. Everything lives in $ZDOTDIR/conf.d/, loaded in numeric order:
#   10-options      shell options, history
#   20-completion   compinit + completion styles
#   30-plugins      third-party plugins from $ZDOTDIR/plugins (installed by chezmoi, see .chezmoiexternal.toml)
#   40-tools        zoxide, starship, fzf, bun
#   50-aliases
#   60-functions
#   70-fzf          fzf options + helpers
#   80-keybindings

zmodload zsh/datetime

# Fastest way to test for an executable in zsh
exists() { (( $+commands[$1] )); }

for _f in "$ZDOTDIR"/conf.d/*.zsh(N); do
  source "$_f"
done
unset _f

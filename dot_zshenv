# vim:ft=zsh
# Environment only. Read by EVERY zsh (login, interactive, scripts), so keep it cheap and side-effect free.
#   interactive setup  → $ZDOTDIR/.zshrc  (+ conf.d/)
#   login PATH tweaks that need Homebrew → $ZDOTDIR/.zprofile
#   machine-local secrets → ~/.zshenv.local (not in the repo)

typeset -U path   # keep PATH entries unique even when this file is sourced twice

# ─── XDG + zsh home ────────────────────────────────────────────────────────────
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"
export ZSH_CACHE_DIR="$XDG_CACHE_HOME/zsh"
[ -d "$ZSH_CACHE_DIR" ] || mkdir -p "$ZSH_CACHE_DIR"

export PROJECTS_DIR="$HOME/projects"
export BREW_HOME=/opt/homebrew

# ─── Toolchains ────────────────────────────────────────────────────────────────
export GOPATH="$HOME/projects/golang"
export BUN_INSTALL="$HOME/.bun"
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
# n (node version manager), only if installed
if [ -d "$HOME/n" ]; then
  export N_PREFIX="$HOME/n"
fi

# ─── PATH  ((N-/) = add only if the directory exists) ──────────────────────────
path+=(
  /usr/local/bin
  ${HOME}/.local/bin(N-/)
  ${XDG_DATA_HOME}/bin(N-/)
  ${HOME}/.npm/bin(N-/)
  ${BUN_INSTALL}/bin(N-/)
  ${N_PREFIX:+$N_PREFIX/bin}(N-/)
  ${HOME}/.fzf/bin(N-/)
  # Go / Dart / Flutter
  ${GOPATH}/bin(N-/)
  ${HOME}/.pub-cache/bin(N-/)
  ${HOME}/flutter/bin(N-/)
  ${HOME}/flutter/.pub-cache/bin(N-/)
  # Homebrew extras
  ${BREW_HOME}/opt/mysql-client/bin(N-/)
  ${XDG_DATA_HOME}/bob/nvim-bin(N-/)
)

case "$(uname)" in
  Darwin)
    export ANDROID_SDK_ROOT=/opt/homebrew/share/android-commandlinetools
    export ANDROID_HOME=$ANDROID_SDK_ROOT
    path+=(
      ${ANDROID_SDK_ROOT}/emulator(N-/)
      ${ANDROID_SDK_ROOT}/platform-tools(N-/)
      ${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin(N-/)
    )
    ;;
  Linux)
    export JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64
    path+=(${JAVA_HOME}/bin(N-/))
    ;;
esac

# ─── Editor, pager, locale ─────────────────────────────────────────────────────
export EDITOR="nvim"
export VISUAL="nvim --cmd 'let g:flatten_wait=1'"
export USE_EDITOR=$EDITOR
export MANPATH="/usr/local/man:$MANPATH"
(( $+commands[nvim] )) && export MANPAGER='nvim +Man!'
export LC_ALL=zh_CN.UTF-8
export LANG=zh_CN.UTF-8
export GPG_TTY=$TTY

# ─── Tool config files ─────────────────────────────────────────────────────────
export RIPGREP_CONFIG_PATH="$XDG_CONFIG_HOME/rg/.ripgreprc"

# ─── Project defaults (Java/Kafka local dev) ───────────────────────────────────
export SPRING_PROFILES_ACTIVE='local'
export KAFKA_BOOTSTRAP_SERVERS='localhost:9092'
export LOG_PATH='./logs'

# ─── Machine-local secrets and overrides (API keys etc.), never committed ───────
[ -f "$HOME/.zshenv.local" ] && source "$HOME/.zshenv.local"
